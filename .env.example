# Copy to .env for local runs. Never commit real secrets.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/upi_router
REDIS_URL=redis://localhost:6379

# Comma-separated merchant API keys. The server stores only hashes (Phase 6).
MERCHANT_API_KEYS=dev_test_key

# Mocks are the default. Real sandbox adapters stay off until credentials are set
# and USE_REAL_GATEWAYS=true (Phase 3).
USE_REAL_GATEWAYS=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
